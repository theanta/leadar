# Root .env — loaded automatically by docker-compose
# Copy to .env and fill in real values before deploying

# Database password (used by both postgres and backend services)
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Apify scraping credentials
APIFY_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=compass~crawler-google-places
APIFY_LINKEDIN_ACTOR_ID=harvestapi~linkedin-company-search

# Apollo.io enrichment
APOLLO_API_KEY=your_apollo_api_key_here

# CORS — set to your production frontend domain
# Must be a valid JSON array string
CORS_ORIGINS=["https://your-domain.com"]
